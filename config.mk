# ============================================================
# config.mk — HorizonRunner プロジェクト設定 (本体とサブ CPU 側の設定ファイル)
#
# NAME と ORG はここだけ書き換えれば、Makefile / link.script / asm_ipl.s /
# scripts の参照は全部追従する。SUB_* は一部に src/asm_subprog.s と
# src/c_subprog.h の写しがあり、そちらも同じ値に直す (下の説明を参照)。
# 直接 lwasm を実行する時は make が渡している -D BODY_LOAD=$(ORG) を
# 自分で与えること。
# ============================================================

# 生成物のファイル名 (build/<NAME>.bin / build/<NAME>.d77 / D77 ラベル)
NAME = horizonrunner

# 本体プログラム (crt0 + main) の開始アドレス
#   = Makefile の本体リンクアドレス
#   = link.script の `section code load` アドレス
#   = asm_ipl.s の BODY_LOAD (IPL が本体を展開する先 + JMP 先)
# IPL は読み込まれた位置から $FB00 へ自分を写してから本体を展開するので、
# 本体は IPL の読み込み先と重なってよい。既定 $0400 は、直接ページ
# ($0000-$00FF) を含む先頭 1 KB を空けた位置。ページ境界 ($xx00) に揃える
# こと (Makefile が検査する)。
ORG  = 0x0400

# ============================================================
# サブ CPU 側メモリマップ (= 唯一の正)
#
# ここに書いた値と src/asm_subprog.s の equ / src/c_subprog.h の #define
# が食い違っていないかを、サブ側のプログラム (build/subprog.bin) を組み
# 立てるたびに scripts/check_layout.py が検査する。**片方だけ直すと転送先と参照先が静かにずれる**ため、目視に
# 頼らない。さらに同スクリプトは build/subprog.bin の実際のサイズを検査し、
# SUB_PROG_ADDR + size が SUB_CODE_END を超えたらビルドを失敗させる
# (超えると自前のスタックを踏んで暴走する。lwasm も lwlink も
#  エラーを出さないので機械で止める)。
#
# ------------------------------------------------------------
# 三枚のプレーンの役割
# ------------------------------------------------------------
#   B プレーン ($0000-$3FFF) … ダブルバッファリングのページ 0。自機 / 自弾 / 敵を白で描く
#   R プレーン ($4000-$7FFF) … ダブルバッファリングのページ 1。同上
#   G プレーン ($8000-$BFFF) … 緑のカラープレーン。地平線と流れる床を描く
# パレット $FD38-$FD3F は「表示中のプレーン (B か R) の該当ビットが 1 なら白、0 でも G が 1 なら緑、
# どちらも 0 なら黒」に潰してあり (src/asm_kbd.s)、表示するページの切替は
# パレットの差し替えだけで行う。各プレーンの末尾 (先頭からのオフセット
# $3E80-$3FFF。表示されない 384 byte x 3) は爆発・敵弾・近距離の敵 B の絵の
# 置場に使う (下の SUB_TAIL*)。
#
# 前提:
#   * VRAM を読み書きする時は必ず VRAM ゲート ($D409) を開けておくこと。
#     閉じたまま読むと $FF かゴミが返る。
#   * 表示オフセットレジスタ $D40E/$D40F は常に 0 (1 度でも書くと
#     VRAM の全アドレスがずれる)。
#   * VRAM にコードを置かない (命令フェッチもゲート開が要り、全処理が
#     大きく遅くなる)。
#   * 毎フレーム読み書きするテーブルを VRAM に置かない。末尾の置場は
#     「起動時に 1 回書き、以後読むだけ」の絵の専用。
# ============================================================

# ---- サブ CPU 側 コンソール RAM ($C000-$CFFF) ----
# テーブルはコードより下位に置く。コードは SUB_PROG_ADDR から上へ
# 伸びるので、下に置いたテーブルにはコードの成長が到達し得ない。
SUB_WORK_ADDR   = 0xC000   # 作業変数 (32 byte の領域)
SUB_TABLE_ADDR  = 0xC020   # ページごとの消し込み表 (2 ページ x 26 件 x 4 byte = 208 byte)
SUB_PROG_ADDR   = 0xC100   # サブ側描画プログラム本体の入口 (+ 絵と模様表)
SUB_CODE_END    = 0xCF80   # コードはここ未満まで (= 自前スタックの下端)
SUB_STACK_ADDR  = 0xCF80   # 自前のスタック 64 byte。asm_subprog.s の entry で
SUB_STACK_TOP   = 0xCFC0   #   呼び手の S を退避してここの上端に張り替え、
                           #   戻る前に元へ戻す。この間の pshs / lbsr の入れ子
                           #   (最大 6 byte) と NMI のフレーム (12 byte) は
                           #   全部ここに積まれる。
                           #   $CFC0-$CFFF の 64 byte は使わない (呼び手の
                           #   作業と重ならないよう空けておく余白)。

# ---- VRAM 各プレーンの末尾 (= 表示されない 384 byte x 3 プレーン) ----
# 各プレーンは 16 KB あるが表示に使うのは 200 line x 80 byte = 16,000 byte
# (先頭からのオフセット $0000-$3E7F) だけで、末尾 $3E80-$3FFF の 384 byte は
# 画面に出ない。サブ側のコードの領域 ($C100-$CF7F) に入り切らない絵
# (爆発・敵弾・近距離の敵 B) はここに置く (起動時に $0A WRITE コマンドで
# 書き込む。scripts/make_sprite.py が各プレーンの末尾の領域に収まるよう
# 割り付ける)。読む時は VRAM ゲートを開けておくこと。
SUB_TAIL0_ADDR  = 0x3E80   # B プレーンの末尾
SUB_TAIL1_ADDR  = 0x7E80   # R プレーンの末尾
SUB_TAIL2_ADDR  = 0xBE80   # G プレーンの末尾
SUB_TAIL_SIZE   = 0x0180   # 各 384 byte

# テープ (CMT) 側のメモリの割り当て (本体の仮置き先、RAM の上限、ステージャの
# スタック、BASIC ローダーの CLEAR の値) は、scripts/d77_to_t77_chunks.py の
# 先頭の定数と scripts/trampoline.asm の定数で決まる (ここには無い)。
